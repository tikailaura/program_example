

import java.util.*;

public class MD4_rogosa {
    // Dots veselu skaitļu masīvs, kuru jāsakārto ar 4 algoritmiem
    static final int[] input = { 54, 70, 75, 63, 17, 59, 87, 16, 93, 81, 60, 67, 90, 53, 
    		88, 9, 61, 8, 96, 98, 12, 34, 66, 76, 38, 55, 58, 27, 92, 45, 41, 4, 
    		20, 22, 69, 77, 86, 35, 19, 32, 49, 15, 29, 23, 83, 95, 25, 91, 33, 
    		47, 24, 62, 13, 42, 73, 44, 78, 72, 7, 5, 10, 48, 71, 18, 39, 97, 
    		64, 79, 51, 74, 31, 37, 57, 30, 94, 80, 28, 1, 56, 85, 46, 100, 82, 
    		40, 26, 21, 68, 43, 14, 3, 65, 99, 89, 52, 84, 36, 2, 6, 11, 50 }; 

    public static void main(String[] args) {
        // Katram algoritmam veic kārtošanu, izvada rezultātus un salīdzinājumu skaitu
        run("Bubble Sort - Classic", MD4_rogosa::bubbleClassic);
        run("Bubble Sort - Improved 1", MD4_rogosa::bubbleEarlyExit);
        run("Bubble Sort - Improved 2", MD4_rogosa::bubbleAdaptive);
        run("Merge Sort", MD4_rogosa::mergeSort);

        // Secinājumi par veiktspēju
        System.out.println("\nSecinājumi:");
        System.out.println("- Merge Sort bija visefektīvākais lielā masīva dēļ (O(n log n)).");
        System.out.println("- Klasiskais burbulis bija vislēnākais (O(n^2)).");
        System.out.println("- Uzlabojumi burbuļa algoritmā samazina nevajadzīgus salīdzinājumus.");
    }

    // Funkcionālais interfeiss, lai viegli nodotu kārtošanas metodes kā parametrus
    interface Sorter { int apply(int[] arr); }

    // Izpilda algoritmu, izvada rezultātu un salīdzinājumu skaitu
    static void run(String name, Sorter sorter) {
        int[] copy = Arrays.copyOf(input, input.length);
        int comps = sorter.apply(copy);
        System.out.println("\n" + name);
        System.out.println("Rezultāts: " + Arrays.toString(copy));
        System.out.println("Salīdzinājumi: " + comps);
    }

    // Klasiskā burbuļa kārtošana: iet cauri visam masīvam vairākas reizes un apmaina blakus esošos elementus
    static int bubbleClassic(int[] a) {
        int c = 0, n = a.length;
        for (int i = 0; i < n - 1; i++)
            for (int j = 0; j < n - 1 - i; j++, c++)
                if (a[j] > a[j + 1]) swap(a, j, j + 1);
        return c;
    }

    // Burbuļa kārtošana 1: pārtrauc ciklu, ja kārtējo iterāciju laikā netika veikta neviena apmaiņa
    static int bubbleEarlyExit(int[] a) {
        int c = 0, n = a.length;
        for (int i = 0; i < n - 1; i++) {
            boolean swapped = false;
            for (int j = 0; j < n - 1 - i; j++, c++)
                if (a[j] > a[j + 1]) { swap(a, j, j + 1); swapped = true; }
            if (!swapped) break; // masīvs jau ir sakārtots
        }
        return c;
    }

    // Burbuļa kārtošana 2: pēdējā apmaiņas pozīcija nosaka nākamo iterāciju garumu
    static int bubbleAdaptive(int[] a) {
        int n = a.length, c = 0, newn;
        do {
            newn = 0; //mainīgais, kurā tiek saglabāts pēdējās veiksmīgās apmaiņas indekss 
            for (int i = 1; i < n; i++, c++)
                if (a[i - 1] > a[i]) { swap(a, i - 1, i); newn = i; }
            n = newn; // turpmāk nav jāsalīdzina pēc pēdējās apmaiņas vietas
        } while (n > 0);
        return c;
    }

    // Merge sort: sadala masīvu daļās, kārto tās atsevišķi un tad apvieno
    static int mergeSort(int[] a) {
        return mergeSort(a, 0, a.length - 1, new int[a.length]);
    }

    // Rekursīvi sadala masīvu divās daļās līdz elementiem, pēc tam apvieno
    static int mergeSort(int[] a, int l, int r, int[] t) {
        if (l >= r) return 0;
        int m = (l + r) / 2, c = 0;
        c += mergeSort(a, l, m, t);
        c += mergeSort(a, m + 1, r, t);
        c += merge(a, l, m, r, t);
        return c;
    }

    // Apvieno divas sakārtotas apakšdaļas vienā masīvā, saglabājot kārtošanas secību
    static int merge(int[] a, int l, int m, int r, int[] t) {
        int i = l, j = m + 1, k = l, c = 0;
        while (i <= m && j <= r) {
            c++;
            t[k++] = (a[i] <= a[j]) ? a[i++] : a[j++];
        }
        while (i <= m) t[k++] = a[i++];
        while (j <= r) t[k++] = a[j++];
        for (i = l; i <= r; i++) a[i] = t[i];
        return c;
    }

    // Palīgmetode elementu apmaiņai vietām
    static void swap(int[] a, int i, int j) {
        int t = a[i]; a[i] = a[j]; a[j] = t;
    }
}   
